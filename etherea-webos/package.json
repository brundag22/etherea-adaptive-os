{
  "name": "etherea-webos",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/desktop-tauri",
    "apps/android-capacitor",
    "packages/core",
    "packages/ui"
  ],
  "scripts": {
    "build": "npm run build -w @etherea/core && npm run build -w @etherea/ui && npm run build -w @etherea/web",
    "lint": "npm run lint -w @etherea/web",
    "typecheck": "npm run typecheck -w @etherea/web",
    "test": "npm run test -w @etherea/core",
    "selfcheck": "node scripts/selfcheck.mjs",
    "binary-guard": "node scripts/binary-guard.mjs",
    "web:dev": "npm run dev -w @etherea/web",
    "web:build": "npm run build -w @etherea/web",
    "web:preview": "npm run preview -w @etherea/web",
    "api:dev": "npm run dev -w @etherea/api",
    "api:start": "npm run start -w @etherea/api"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2"
}
